{
  "name": "skills-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Employee Skills & Competency Management Dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
