# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# This file is only needed for HOST-side work: `npm run dev`, `npm run db:migrate`
# and the Prisma CLI. `docker compose up` needs no .env at all.
#
# DATABASE_URL points at localhost because that is where the db container
# publishes its port. Containers cannot use it — inside the compose network the
# host is `db` — so docker-compose.yml deliberately reads COMPOSE_DATABASE_URL
# instead and never DATABASE_URL. Do not "fix" that by renaming one of them.
DATABASE_URL="postgresql://skills:skills_dev_password@localhost:5432/skills?schema=public"

# Only set this if you change the POSTGRES_* values below, or want the
# containers to talk to a database other than the bundled one.
# COMPOSE_DATABASE_URL="postgresql://skills:skills_dev_password@db:5432/skills?schema=public"

POSTGRES_USER=skills
POSTGRES_PASSWORD=skills_dev_password
POSTGRES_DB=skills

# --- Authentication -------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public URL of the app, used for OIDC redirect URIs.
AUTH_URL=http://localhost:3000

# Microsoft Entra ID app registration.
# Redirect URI to register: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Emails granted ADMIN on first sign-in, so the first admin exists before any
# role can be assigned in-app. Comma-separated.
ADMIN_BOOTSTRAP_EMAILS=

# --- Local development without Entra ID -----------------------------------
# When set (and NODE_ENV is not production), the app skips SSO and signs you in
# as this user. Format: email|Display Name|ROLE   (ROLE: ADMIN|MANAGER|EMPLOYEE)
# Leave empty to force real SSO.
AUTH_DEV_USER="dev.admin@example.com|Dev Admin|ADMIN"

# --- Application tuning ---------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Ratings not reviewed in this many months are flagged stale (FR-DSH-04).
STALE_RATING_MONTHS=6
# A skill with fewer than this many people rated 3+ is a gap (FR-DSH-03).
GAP_MIN_PEOPLE=2
# Corrections older than this many months get an extra confirmation (FR-HIS-08).
CORRECTION_WARN_MONTHS=12

LOG_LEVEL=info
