/// Skill groupings, e.g. Test Automation (Dataverse table skl_skillcategory).
table 'Skill Category'

	column SkillCategoryId
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: skl_skillcategoryid

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: skl_name

	column 'Category Description'
		dataType: string
		summarizeBy: none
		sourceColumn: skl_description

	/// Drives the order categories appear in on a visual, rather than alphabetical.
	column 'Display Order'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: skl_displayorder

	partition 'Skill Category' = m
		mode: import
		source = ```
				let
				    Source = CommonDataService.Database(EnvironmentHost, [CreateNavigationProperties = false]),
				    Category = Source{[Schema = "dbo", Item = "skl_skillcategory"]}[Data],
				    Selected = Table.SelectColumns(
				        Category,
				        {"skl_skillcategoryid", "skl_name", "skl_description", "skl_displayorder", "skl_isactive"},
				        MissingField.UseNull
				    ),
				    ActiveOnly = Table.SelectRows(Selected, each [skl_isactive] <> false),
				    Trimmed = Table.RemoveColumns(ActiveOnly, {"skl_isactive"})
				in
				    Trimmed
				```

	annotation PBI_ResultType = Table
