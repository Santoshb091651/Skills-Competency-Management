model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_QueryOrder = ["EnvironmentHost","Employee","Skill Category","Skill","Rating Level","Employee Skill","Skill Assessment","Date","Manager Hierarchy"]

ref table Employee
ref table 'Skill Category'
ref table Skill
ref table 'Rating Level'
ref table 'Employee Skill'
ref table 'Skill Assessment'
ref table Date
ref table 'Manager Hierarchy'

ref role 'Employee Self'
ref role 'Manager Team'
ref role 'Organisation Wide'

ref expression EnvironmentHost
